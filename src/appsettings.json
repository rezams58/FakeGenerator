{
  "ConnectionStrings": {
    "SqlServer": "Server=db-dev;Database=SuperApp_Dev;Integrated Security=false;Persist Security Info=True;Trusted_Connection=True;TrustServerCertificate=true"
  },
  "Kafka": {
    "BootstrapServers": "192.168.3.41:9092,192.168.3.41:9094,192.168.3.41:9095",
    "Topic": "orders",
    "PartitionCount": 6,
    "ClientId": "fake-order-generator",
    "Acks": "All",
    "CompressionType": "Lz4",
    "LingerMs": 5,
    "BatchSize": 262144
  },
  "Generator": {
    "Enabled": true,
    "BatchSize": 5000,
    "IntervalMilliseconds": 100,
    "TargetEventCount": 500000,
    "MinOrderAmount": 100,
    "MaxOrderAmount": 5000000,
    "CustomerCount": 100000,
    "OrderHistoryDays": 730,
    "MaxActiveEntities": 10000,
    "AdvanceProbability": 0.6,
    "NationalCodeTable": "dbo.NationalCodePrefixes",
    "Entities": {
      "Order": {
        "PartitionKey": "CustomerId",
        "Lifecycle": {
          "InitialState": "Created",
          "States": [ "Created", "Paid", "Shipped", "Delivered", "Cancelled" ],
          "TerminalStates": [ "Delivered", "Cancelled" ],
          "Transitions": [
            { "From": "Created", "To": "Paid", "Weight": 85 },
            { "From": "Created", "To": "Cancelled", "Weight": 15 },
            { "From": "Paid", "To": "Shipped", "Weight": 90 },
            { "From": "Paid", "To": "Cancelled", "Weight": 10 },
            { "From": "Shipped", "To": "Delivered", "Weight": 100 }
          ]
        }
      }
    }
  },
  "Publisher": {
    "Enabled": true,
    "BatchSize": 500,
    "IdleDelayMilliseconds": 100,
    "RetryDelayMilliseconds": 1000,
    "MaxRetryCount": 10,
    "LeaseDurationSeconds": 90,
    "LeaseRenewIntervalSeconds": 20,
    "MaxPartitionsPerInstance": 6
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
